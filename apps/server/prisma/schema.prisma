// LibreDiary Database Schema
// Phase 1: Core models only

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  passwordHash    String?
  name            String?
  avatarUrl       String?
  locale          String    @default("en")

  // Notification preferences (JSON)
  // Controls which notification types send emails
  // Default: all enabled (empty object means all enabled)
  notificationPrefs Json @default("{}")

  // Super Admin flag (platform-wide)
  isSuperAdmin Boolean @default(false)

  // Onboarding: set when user completes the onboarding wizard
  onboardingCompletedAt DateTime?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt           DateTime? // Soft delete
  deletionRequestedAt DateTime? // GDPR: when account deletion was requested

  // Relations
  memberships        OrganizationMember[]
  createdPages       Page[]               @relation("PageCreatedBy")
  updatedPages       Page[]               @relation("PageUpdatedBy")
  sessions           Session[]
  accounts           Account[]            // OAuth linked accounts
  invitesSent        Invite[]             @relation("InvitesSent")
  favorites          Favorite[]
  pageVersions       PageVersion[]        @relation("PageVersionCreatedBy")
  pagePermissions    PagePermission[]     @relation("PagePermissionUser")
  grantedPermissions PagePermission[]     @relation("PagePermissionGrantedBy")
  comments           Comment[]            @relation("CommentCreatedBy")
  resolvedComments   Comment[]            @relation("CommentResolvedBy")
  mentions           Mention[]            @relation("MentionedUser")
  notifications      Notification[]
  createdDatabases   Database[]           @relation("DatabaseCreatedBy")
  createdDatabaseRows DatabaseRow[]       @relation("DatabaseRowCreatedBy")
  createdAutomations  Automation[]         @relation("AutomationCreatedBy")
  createdTemplates   Template[]           @relation("TemplateCreatedBy")
  uploadedFiles      File[]               @relation("FileUploadedBy")
  triggeredBackups   Backup[]             @relation("BackupTriggeredBy")
  apiTokens          ApiToken[]
  createdWebhooks    Webhook[]            @relation("WebhookCreatedBy")
  dataExports        DataExport[]
  encryption                UserEncryption?
  keyShares                 WorkspaceKeyShare[]
  encryptionChangeRequests  EncryptionChangeRequest[]

  @@index([email])
  @@index([deletedAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// OAuth linked accounts (GitHub, Google, etc.)
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "github", "google"
  providerAccountId String // The user's ID from the OAuth provider

  // OAuth tokens (optional, stored if needed for API calls)
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId]) // One account per provider per user
  @@unique([userId, provider])            // User can only link one account per provider
  @@index([userId])
}

model VerificationToken {
  id         String    @id @default(cuid())
  identifier String
  token      String    @unique
  type       TokenType
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  usedAt     DateTime?

  @@index([identifier])
  @@index([token])
}

model Invite {
  id             String       @id @default(cuid())
  email          String
  token          String       @unique
  organizationId String
  role           OrgRole      @default(MEMBER)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("InvitesSent", fields: [invitedById], references: [id])

  @@index([email])
  @@index([token])
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ============================================
// ORGANIZATIONS & MEMBERSHIPS
// ============================================

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  // Branding
  logoUrl     String?
  accentColor String? @default("#6366f1") // Indigo

  // Settings
  allowedDomains String[] @default([]) // Domain lockdown (e.g., ["company.com", "corp.com"])

  // AI Settings
  aiEnabled Boolean @default(true)

  // E2EE
  isEncrypted        Boolean   @default(false)
  encryptionDisabledAt DateTime? // Set when E2EE is disabled; triggers 7-day grace period before data purge

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  members        OrganizationMember[]
  pages          Page[]
  invites        Invite[]
  databases      Database[]
  templates      Template[]
  files          File[]
  backups        Backup[]
  webhooks       Webhook[]
  automations    Automation[]
  keyShares              WorkspaceKeyShare[]
  encryptionChangeRequests EncryptionChangeRequest[]

  @@index([slug])
  @@index([deletedAt])
  @@index([encryptionDisabledAt])
}

model OrganizationMember {
  id             String  @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// ============================================
// PAGES & CONTENT
// ============================================

model Page {
  id             String @id @default(cuid())
  organizationId String

  // Hierarchy
  parentId String?
  position Int     @default(0) // For ordering siblings

  // Page type: 'document' | 'canvas'
  type     String  @default("document")

  // Content
  title    String  @default("Untitled")
  icon     String? // Emoji or icon identifier
  coverUrl String?

  // Yjs document state (stored as bytes)
  yjsState Bytes?

  // HTML content (for REST-based saving before Yjs integration)
  htmlContent  String?
  // Plain text extracted from htmlContent (for PG FTS search_vector trigger)
  plainContent String?

  // Sharing
  isPublic   Boolean @default(false)
  publicSlug String? @unique

  // Soft delete
  trashedAt DateTime?

  // Audit
  createdById String
  updatedById String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Page?             @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Page[]            @relation("PageHierarchy")
  createdBy    User              @relation("PageCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?             @relation("PageUpdatedBy", fields: [updatedById], references: [id])
  favorites    Favorite[]
  versions     PageVersion[]
  permissions  PagePermission[]
  comments     Comment[]
  databases    Database[]
  files        File[]

  @@index([organizationId])
  @@index([parentId])
  @@index([trashedAt])
  @@index([publicSlug])
  @@index([createdById])
  @@index([organizationId, trashedAt])
  @@index([organizationId, parentId, position])
}

// ============================================
// PAGE VERSIONS (Version History)
// ============================================

model PageVersion {
  id        String   @id @default(cuid())
  pageId    String
  version   Int
  title     String
  yjsState  Bytes?
  createdById String
  createdAt DateTime @default(now())

  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy User     @relation("PageVersionCreatedBy", fields: [createdById], references: [id])

  @@unique([pageId, version])
  @@index([pageId])
}

// ============================================
// PAGE PERMISSIONS
// ============================================

model PagePermission {
  id     String          @id @default(cuid())
  pageId String
  userId String? // Nullable for guest/public access

  // Permission level
  level PermissionLevel @default(VIEW)

  // For guest access links
  shareToken     String?   @unique
  expiresAt      DateTime? // Optional expiration for share links
  lastAccessedAt DateTime? // Last time a guest used this share link

  // Audit
  grantedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  page      Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user      User? @relation("PagePermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User  @relation("PagePermissionGrantedBy", fields: [grantedById], references: [id])

  @@unique([pageId, userId]) // One permission per user per page
  @@index([pageId])
  @@index([userId])
  @@index([shareToken])
}

enum PermissionLevel {
  VIEW        // Can only view the page
  EDIT        // Can edit content but not share or delete
  FULL_ACCESS // Can edit, share, and manage the page
}

// ============================================
// FAVORITES
// ============================================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  pageId    String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@index([userId])
}

// ============================================
// SYSTEM SETTINGS
// ============================================

model SystemSettings {
  id    String @id @default("system")

  // Setup state
  setupCompleted   Boolean   @default(false)
  setupCompletedAt DateTime?
  setupCompletedBy String?

  // General settings
  siteName                 String  @default("LibreDiary")
  allowSignups             Boolean @default(false) // Invite-only by default
  requireEmailVerification Boolean @default(true)
  sessionMaxAge            Int     @default(604800000) // 7 days in ms
  maxOrganisationsPerUser  Int     @default(0)         // 0 = unlimited
  defaultUserLocale        String  @default("en")

  // AI settings
  aiEnabled         Boolean @default(false)
  openrouterApiKey  String?
  openrouterModel   String  @default("openai/gpt-4o-mini")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// COMMENTS
// ============================================

model Comment {
  id     String @id @default(cuid())
  pageId String

  // Threading - parentId for replies
  parentId String?

  // Inline comments - reference to specific block in editor
  blockId String?

  // Content
  content String

  // Resolution status
  isResolved Boolean @default(false)
  resolvedAt DateTime?
  resolvedById String?

  // Audit
  createdById String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  page       Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentThread")
  createdBy  User      @relation("CommentCreatedBy", fields: [createdById], references: [id])
  resolvedBy User?     @relation("CommentResolvedBy", fields: [resolvedById], references: [id])
  mentions   Mention[]

  @@index([pageId])
  @@index([pageId, createdAt])
  @@index([parentId])
  @@index([blockId])
  @@index([createdById])
}

// ============================================
// MENTIONS
// ============================================

model Mention {
  id        String @id @default(cuid())
  commentId String
  userId    String // The mentioned user

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation("MentionedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId]) // One mention per user per comment
  @@index([commentId])
  @@index([userId])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id     String           @id @default(cuid())
  userId String           // Recipient
  type   NotificationType

  // Content
  title   String
  message String?

  // Context data (JSON) - pageId, commentId, etc.
  data Json?

  // Status
  isRead Boolean @default(false)
  readAt DateTime?

  // Email tracking
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([userId, isRead, createdAt])
}

enum NotificationType {
  MENTION           // Someone mentioned you in a comment
  COMMENT_REPLY     // Someone replied to your comment
  PAGE_SHARED       // A page was shared with you
  COMMENT_RESOLVED  // Your comment was resolved
  INVITATION        // You were invited to an organization
  TASK_DUE          // A recurring task row is due
}

// ============================================
// DATABASES (Structured Tables)
// ============================================

enum PropertyType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  DATE
  CHECKBOX
  URL
  EMAIL
  PHONE
  PERSON
  FILES
  RELATION
  ROLLUP
  FORMULA
  CREATED_TIME
  CREATED_BY
  UPDATED_TIME
  UPDATED_BY
  DURATION
  RECURRENCE
}

enum RecurrenceStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum ViewType {
  TABLE
  KANBAN
  CALENDAR
  GALLERY
}

model Database {
  id             String   @id @default(cuid())
  organizationId String
  pageId         String?
  name           String
  createdById    String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  page         Page?              @relation(fields: [pageId], references: [id], onDelete: SetNull)
  createdBy    User               @relation("DatabaseCreatedBy", fields: [createdById], references: [id])
  properties   DatabaseProperty[]
  views        DatabaseView[]
  rows         DatabaseRow[]
  automations  Automation[]

  @@index([organizationId])
  @@index([pageId])
  @@index([createdById])
}

model DatabaseProperty {
  id         String       @id @default(cuid())
  databaseId String
  name       String
  type       PropertyType @default(TEXT)
  position   Int          @default(0)
  config     Json?

  // Relations
  database Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([databaseId])
  @@index([databaseId, position])
}

model DatabaseView {
  id         String   @id @default(cuid())
  databaseId String
  name       String
  type       ViewType @default(TABLE)
  position   Int      @default(0)
  config     Json?

  // Relations
  database Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([databaseId])
  @@index([databaseId, position])
}

model DatabaseRow {
  id         String @id @default(cuid())
  databaseId String
  position   Int    @default(0)
  cells      Json   @default("{}")
  createdById String

  // Recurrence
  recurrenceRule     String?           // RRULE string, e.g. "FREQ=WEEKLY;BYDAY=MO"
  recurrenceStatus   RecurrenceStatus?
  nextOccurrenceAt   DateTime?         // When the next copy should be created
  recurrenceParentId String?           // Points to the original row this was cloned from

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  database          Database      @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  createdBy         User          @relation("DatabaseRowCreatedBy", fields: [createdById], references: [id])
  recurrenceParent  DatabaseRow?  @relation("RecurrenceChain", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChildren DatabaseRow[] @relation("RecurrenceChain")

  @@index([databaseId])
  @@index([databaseId, position])
  @@index([createdById])
  @@index([nextOccurrenceAt])
  @@index([recurrenceStatus, nextOccurrenceAt])
}

// ============================================
// AUTOMATIONS
// ============================================

enum AutomationTriggerType {
  ROW_CREATED
  PROPERTY_UPDATED
  DATE_REACHED
}

enum AutomationActionType {
  UPDATE_PROPERTY
  SEND_NOTIFICATION
  CREATE_PAGE
}

enum AutomationLogStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model Automation {
  id             String                @id @default(cuid())
  organizationId String
  databaseId     String
  name           String
  isEnabled      Boolean               @default(true)
  triggerType    AutomationTriggerType
  triggerConfig  Json?                 // { propertyId?, matchValue?, daysBeforeDate? }
  actionType     AutomationActionType
  actionConfig   Json?                 // { propertyId?, value?, message?, pageTitle? }
  createdById    String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  database     Database        @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  createdBy    User            @relation("AutomationCreatedBy", fields: [createdById], references: [id])
  logs         AutomationLog[]

  @@index([organizationId])
  @@index([databaseId])
  @@index([databaseId, isEnabled, triggerType])
}

model AutomationLog {
  id           String              @id @default(cuid())
  automationId String
  triggerRowId String?             // The row that fired the trigger (null for DATE_REACHED)
  status       AutomationLogStatus
  errorMessage String?
  durationMs   Int?

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([automationId, createdAt])
  @@index([createdAt])
}

// ============================================
// FILES & STORAGE
// ============================================

enum StorageType {
  LOCAL
  MINIO
  S3
}

model File {
  id             String      @id @default(cuid())
  organizationId String
  pageId         String?
  name           String
  originalName   String
  mimeType       String
  size           Int
  storageType    StorageType
  storagePath    String
  url            String?
  uploadedById   String

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  page         Page?        @relation(fields: [pageId], references: [id], onDelete: SetNull)
  uploadedBy   User         @relation("FileUploadedBy", fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([pageId])
  @@index([uploadedById])
}

// ============================================
// TEMPLATES
// ============================================

model Template {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  description    String?
  icon           String?
  category       String?
  isBuiltIn      Boolean @default(false)

  // Template content (stored as Yjs state)
  yjsState Bytes?

  // Audit
  createdById String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TemplateCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([organizationId, category])
  @@index([createdById])
}

// ============================================
// BACKUPS
// ============================================

enum BackupType {
  ORGANISATION
  SYSTEM
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Backup {
  id             String       @id @default(cuid())
  type           BackupType
  status         BackupStatus @default(PENDING)

  // Organisation scope (null for system backups)
  organizationId String?

  // File metadata
  fileName       String?
  fileSize       Int?
  storagePath    String?
  storageType    String?    // LOCAL or S3
  isEncrypted    Boolean    @default(false)

  // Error tracking
  errorMessage   String?

  // Audit
  triggeredById  String?

  // Timing
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  triggeredBy    User?         @relation("BackupTriggeredBy", fields: [triggeredById], references: [id])

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// API TOKENS
// ============================================

model ApiToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenHash   String    @unique  // SHA-256 hash of the token
  tokenPrefix String             // First 8 chars for display
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// ============================================
// WEBHOOKS
// ============================================

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model Webhook {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  url            String
  secret         String   // HMAC-SHA256 signing secret
  events         String[] // Array of event names
  isActive       Boolean  @default(true)
  createdById    String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("WebhookCreatedBy", fields: [createdById], references: [id])
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@index([organizationId, isActive])
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  webhookId    String
  event        String
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  statusCode   Int?
  responseBody String?
  attempts     Int                   @default(0)
  nextRetryAt  DateTime?

  // Timestamps
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Relations
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([webhookId, createdAt])
  @@index([status])
  @@index([status, nextRetryAt])
  @@index([nextRetryAt])
  @@index([createdAt])
}

// ============================================
// GDPR DATA EXPORTS
// ============================================

enum DataExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model DataExport {
  id           String           @id @default(cuid())
  userId       String
  status       DataExportStatus @default(PENDING)

  // File metadata
  fileName     String?
  fileSize     Int?
  storagePath  String?

  // Error tracking
  errorMessage String?

  // Timing
  requestedAt  DateTime         @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  expiresAt    DateTime?        // When the download link expires
  downloadedAt DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

// ============================================
// E2EE (End-to-End Encryption)
// ============================================

model UserEncryption {
  id     String @id @default(cuid())
  userId String @unique

  // X25519 public key (Base64-encoded, 32 bytes raw)
  publicKey String

  // X25519 private key encrypted with master key (Base64-encoded)
  encryptedPrivateKey String

  // Salt used for Argon2id key derivation (Base64-encoded, 16 bytes)
  keySalt String

  // Argon2id parameters (stored for future-proofing)
  keyParams Json @default("{\"memoryLimit\":65536,\"opsLimit\":3}")

  // Recovery: master key encrypted with recovery-derived key (JSON envelope)
  recoveryEncryptedMasterKey Json?

  // Recovery: salt used for HKDF from recovery key (Base64-encoded)
  recoverySalt String?

  // SHA-256 hash of recovery key for verification (Base64-encoded)
  recoveryKeyHash String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkspaceKeyShare {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  // Workspace key encrypted for this user (Base64-encoded, X25519 box)
  encryptedKey String

  // Nonce used for the X25519 box encryption (Base64-encoded)
  nonce String

  // Public key of the user who shared the key (for decryption)
  sharedByPublicKey String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// ============================================
// E2EE Change Requests (OTP verification)
// ============================================

enum EncryptionChangeType {
  ENABLE
  DISABLE
}

enum EncryptionChangeStatus {
  PENDING_VERIFICATION
  VERIFIED
  COMPLETED
  CANCELLED
}

model EncryptionChangeRequest {
  id             String                 @id @default(cuid())
  organizationId String
  requestedById  String

  type   EncryptionChangeType
  status EncryptionChangeStatus @default(PENDING_VERIFICATION)

  // OTP verification (hashed code + expiry)
  verificationCodeHash String
  verificationExpiresAt DateTime

  // For DISABLE: scheduled purge date (7 days after verification)
  scheduledPurgeAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([requestedById])
  @@index([organizationId, type, status])
  @@index([scheduledPurgeAt])
}

// ============================================
// AUDIT LOGGING
// ============================================

enum AuditAction {
  // Auth
  AUTH_LOGIN
  AUTH_LOGOUT
  AUTH_REGISTER
  AUTH_PASSWORD_RESET
  AUTH_EMAIL_VERIFIED
  USER_PROFILE_UPDATED

  // Pages
  PAGE_CREATED
  PAGE_UPDATED
  PAGE_TRASHED
  PAGE_RESTORED
  PAGE_DELETED_PERMANENTLY
  PAGE_MADE_PUBLIC
  PAGE_MADE_PRIVATE

  // Comments
  COMMENT_CREATED
  COMMENT_UPDATED
  COMMENT_DELETED
  COMMENT_RESOLVED
  COMMENT_UNRESOLVED

  // Permissions
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  PERMISSION_UPDATED
  SHARE_LINK_CREATED
  SHARE_LINK_DELETED

  // Organisation
  ORG_CREATED
  ORG_UPDATED
  ORG_DELETED
  ORG_RESTORED
  MEMBER_ADDED
  MEMBER_INVITED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  MEMBER_LEFT

  // Admin
  ADMIN_USER_UPDATED
  ADMIN_USER_DELETED
  ADMIN_USER_RESTORED
  ADMIN_ORG_UPDATED
  ADMIN_ORG_DELETED
  ADMIN_ORG_RESTORED
  ADMIN_SETTINGS_UPDATED
  ADMIN_SEARCH_REINDEX

  // Resources
  DATABASE_CREATED
  DATABASE_DELETED
  DATABASE_ROW_RECURRENCE_SET
  DATABASE_ROW_RECURRENCE_TRIGGERED
  AUTOMATION_CREATED
  AUTOMATION_UPDATED
  AUTOMATION_DELETED
  AUTOMATION_TRIGGERED
  BACKUP_CREATED
  BACKUP_DOWNLOADED
  BACKUP_DELETED
  BACKUP_RESTORED
  API_TOKEN_CREATED
  API_TOKEN_DELETED
  WEBHOOK_CREATED
  WEBHOOK_UPDATED
  WEBHOOK_DELETED
  TEMPLATE_CREATED
  TEMPLATE_DELETED
  AI_TRANSLATION
  AI_WRITING

  // E2EE
  E2EE_SETUP_COMPLETED
  E2EE_RECOVERY_KEY_GENERATED
  E2EE_RECOVERY_USED
  E2EE_WORKSPACE_ENCRYPTED
  E2EE_WORKSPACE_DECRYPTED
  E2EE_KEY_SHARED
  E2EE_KEY_REVOKED

  // GDPR
  GDPR_DATA_EXPORT_REQUESTED
  GDPR_DATA_EXPORT_DOWNLOADED
  GDPR_ACCOUNT_DELETION_REQUESTED
  GDPR_ACCOUNT_DELETION_CANCELLED
  GDPR_ACCOUNT_DELETED
}

// No foreign keys — audit logs must persist as immutable records even after entity deletion
model AuditLog {
  id             String      @id @default(cuid())
  action         AuditAction
  userId         String?     // null for system actions
  organizationId String?     // null for system-level
  resourceType   String?     // "page", "user", "organization", etc.
  resourceId     String?     // ID of affected resource
  metadata       Json?       // extra context (old/new values)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  @@index([action])
  @@index([userId])
  @@index([organizationId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([action, createdAt])
}
