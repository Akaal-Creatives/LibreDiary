{
  "name": "@librediary/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "clean": "rm -rf dist .turbo coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed-dev.ts",
    "db:migrate:search": "tsx prisma/migrations/run-migrations.ts",
    "search:reindex": "tsx --env-file=.env src/scripts/reindex-meilisearch.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "@hocuspocus/server": "^3.4.4",
    "@librediary/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "archiver": "^7.0.1",
    "arctic": "^3.7.0",
    "argon2": "^0.44.0",
    "diff": "^8.0.3",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0",
    "file-type": "^21.3.0",
    "meilisearch": "^0.55.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "pino": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "tar": "^7.5.7",
    "yjs": "^13.6.29",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@librediary/eslint-config": "workspace:*",
    "@librediary/tsconfig": "workspace:*",
    "@types/archiver": "^7.0.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^25.2.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.10",
    "@types/tar": "^6.1.13",
    "@vitest/coverage-v8": "^4.0.18",
    "prisma": "^7.4.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
