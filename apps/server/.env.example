# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
APP_SECRET=your-secret-key-must-be-at-least-32-characters-long

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/librediary

# ===========================================
# SESSION
# ===========================================
SESSION_SECRET=your-session-secret-must-be-at-least-32-characters
SESSION_MAX_AGE=604800000

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:5173

# ===========================================
# TRUSTED PROXIES
# ===========================================
# Comma-separated IPs/CIDRs, or 'true' to trust all (default).
# In production, set to your reverse proxy IP (e.g., '127.0.0.1' or '10.0.0.0/8').
TRUSTED_PROXY_IPS=true

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===========================================
# SMTP (Email)
# ===========================================
SMTP_HOST=192.168.225.101
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@librediary.local

# ===========================================
# AI (OpenRouter)
# ===========================================
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_DEFAULT_MODEL=openai/gpt-4o-mini
