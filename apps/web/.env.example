# LibreDiary Web — Environment Variables
# Copy this file to .env and adjust values for your environment.

# Base URL for the backend API
# In development, use a relative path to leverage the Vite dev proxy (avoids cross-origin CSRF issues).
# In production, use a relative path or the full URL of your API.
VITE_API_URL=/api/v1

# Enable demo mode (disables login form, shows demo credentials)
VITE_DEMO_MODE=false
