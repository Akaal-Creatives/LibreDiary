# ===========================================
# LibreDiary - Docker Environment Configuration
#
# Copy this file to .env in the same directory as
# your docker-compose.yml and fill in your values.
#
# Generate secrets with:
#   openssl rand -base64 48
#
# Developed by Akaal Creatives
# https://www.akaalcreatives.com
# ===========================================


# ===========================================
# APPLICATION (required)
# ===========================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Public URL of the API server (used for constructing callback URLs, etc.)
# In full-stack compose with nginx, this is the same as FRONTEND_URL
APP_URL=https://diary.example.com

# Public URL of the API server
# (same as APP_URL if using the full-stack compose with nginx)
API_URL=https://diary.example.com

# Public URL of the frontend
# (set to a different domain if web is hosted separately, e.g. Cloudflare Pages)
FRONTEND_URL=https://diary.example.com

# Application secret — used for signing tokens
# REQUIRED: minimum 32 characters, generate with: openssl rand -base64 48
APP_SECRET=


# ===========================================
# DATABASE (required)
# ===========================================

# Connection string used by the server
# When running with Docker Compose, the hostname is the service name (postgres)
DATABASE_URL=postgresql://librediary:CHANGE_ME@postgres:5432/librediary

# PostgreSQL container credentials
# These are used by the postgres service in docker-compose
POSTGRES_USER=librediary
POSTGRES_PASSWORD=              # REQUIRED — generate with: openssl rand -base64 32
POSTGRES_DB=librediary


# ===========================================
# AUTHENTICATION (required)
# ===========================================

# Session secret — used for signing session cookies
# REQUIRED: minimum 32 characters, generate with: openssl rand -base64 48
SESSION_SECRET=

# Session lifetime in milliseconds (default: 7 days)
SESSION_MAX_AGE=604800000


# ===========================================
# CORS (required for production)
# ===========================================

# Allowed origin for cross-origin requests
# Set to your public web app URL
# For full-stack compose: same as APP_URL
# For API-only compose: the domain where the web app is hosted
CORS_ORIGIN=https://diary.example.com


# ===========================================
# EMAIL (required for password reset, invites, etc.)
# ===========================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false               # Set to true for port 465 (implicit TLS)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com


# ===========================================
# OAUTH (optional)
# ===========================================

# GitHub OAuth
# Create at: https://github.com/settings/developers
# Callback URL: https://diary.example.com/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
# Callback URL: https://diary.example.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ===========================================
# STORAGE (optional — defaults to local)
# ===========================================

# Options: LOCAL, MINIO, S3
STORAGE_TYPE=LOCAL

# Maximum upload size in bytes (default: 10MB)
STORAGE_MAX_FILE_SIZE=10485760

# Local storage paths (Docker volumes handle these automatically)
STORAGE_LOCAL_PATH=/app/data/files
BACKUP_LOCAL_PATH=/app/backups

# --- MinIO (required if STORAGE_TYPE=MINIO) ---
# Only needed with --profile storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin      # CHANGE in production
MINIO_BUCKET=librediary
MINIO_USE_SSL=false

# MinIO container credentials (used by docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin   # CHANGE in production
MINIO_CONSOLE_PORT=9001

# --- S3 (required if STORAGE_TYPE=S3) ---
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=librediary


# ===========================================
# BACKUP (optional)
# ===========================================

BACKUP_ENABLED=false
BACKUP_STORAGE_TYPE=LOCAL        # LOCAL or S3
BACKUP_SCHEDULE=0 2 * * *       # Cron: daily at 2 AM
BACKUP_RETENTION_DAYS=30         # Auto-delete backups older than N days
BACKUP_MAX_SIZE_MB=500           # Maximum backup size in MB

# Backup to S3/B2 (required if BACKUP_STORAGE_TYPE=S3)
BACKUP_S3_ENDPOINT=             # e.g. https://s3.us-west-000.backblazeb2.com
BACKUP_S3_REGION=us-west-000
BACKUP_S3_BUCKET=librediary-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=


# ===========================================
# AI — OpenRouter (optional)
# ===========================================

# Get an API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_DEFAULT_MODEL=openai/gpt-4o-mini


# ===========================================
# SEARCH — Meilisearch (optional)
# ===========================================

# When configured, Meilisearch is used as the primary search backend.
# PostgreSQL full-text search is the fallback when Meilisearch is
# unavailable or not configured.
# Only needed with --profile search

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=masterkey    # CHANGE in production
MEILISEARCH_INDEX_PREFIX=librediary


# ===========================================
# RATE LIMITING (optional)
# ===========================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100          # Max requests per window
RATE_LIMIT_WINDOW=60             # Window in seconds


# ===========================================
# DEMO MODE (optional — for demo instances only)
# ===========================================

# Enable demo mode to show a banner on the login page
# and automatically reseed data on a schedule
DEMO_MODE=false
DEMO_RESEED_SCHEDULE=0 0 * * *   # Cron: midnight daily


# ===========================================
# NGINX / TLS (full-stack compose only)
# ===========================================

# Domain for nginx server_name directive
DOMAIN=localhost

# Ports exposed on the host
HTTP_PORT=80
HTTPS_PORT=443

# Path to TLS certificates (fullchain.pem + privkey.pem)
SSL_CERT_PATH=./nginx/ssl
