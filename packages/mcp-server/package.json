{
  "name": "@librediary/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for LibreDiary - enables AI assistants to manage workspaces",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "bin": {
    "librediary-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0"
  },
  "devDependencies": {
    "@librediary/eslint-config": "workspace:*",
    "@librediary/shared": "workspace:*",
    "@librediary/tsconfig": "workspace:*",
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
