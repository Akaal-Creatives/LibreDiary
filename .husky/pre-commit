# Block commits containing sensitive path keywords
BLOCKED_WORDS=("Anthropic" "claude")
# Exclude the hook file itself so its own blocklist definition is not flagged.
DIFF=$(git diff --cached --unified=0 -- . ':(exclude).husky/pre-commit')
for word in "${BLOCKED_WORDS[@]}"; do
  if echo "$DIFF" | grep -iq "^+.*$word"; then
    echo "COMMIT BLOCKED: staged changes contain the forbidden word \"$word\"."
    echo "Review your staged files and remove any references before committing."
    exit 1
  fi
done

# Secret gate — block a commit that stages a secret. gitleaks 8.18+ uses the
# `git` subcommand; older releases used `protect`. Skips (with a notice) if
# gitleaks is not installed, so the hook never hard-fails on a fresh machine.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner || {
    echo "gitleaks: staged secret detected — commit blocked."
    exit 1
  }
else
  echo "gitleaks not installed — skipping secret scan (brew install gitleaks)."
fi

pnpm lint-staged

# Typecheck packages that have staged TypeScript/Vue changes
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

NEED_SERVER=false
NEED_WEB=false
NEED_SHARED=false
NEED_MCP=false

for f in $STAGED; do
  case "$f" in
    apps/server/src/*.ts)        NEED_SERVER=true ;;
    apps/web/src/*.ts|apps/web/src/*.vue) NEED_WEB=true ;;
    packages/shared/src/*.ts)    NEED_SHARED=true ;;
    packages/mcp-server/src/*.ts) NEED_MCP=true ;;
    packages/tsconfig/*)         NEED_SERVER=true; NEED_WEB=true; NEED_SHARED=true; NEED_MCP=true ;;
  esac
done

FILTERS=""
if $NEED_SHARED; then FILTERS="$FILTERS --filter @librediary/shared"; fi
if $NEED_MCP; then FILTERS="$FILTERS --filter @librediary/mcp-server"; fi
if $NEED_SERVER; then FILTERS="$FILTERS --filter @librediary/server"; fi
if $NEED_WEB; then FILTERS="$FILTERS --filter @librediary/web"; fi

if [ -n "$FILTERS" ]; then
  echo "Running typecheck for changed packages..."
  pnpm $FILTERS run typecheck
fi
